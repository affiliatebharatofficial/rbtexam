{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rbtexam",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rbtexam-db",
      "database_id": "d2de54af-e054-490b-add7-36505b5d1b53"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rbtexam"
    }
  ],
  "vars": {
    "DATABASE_ENGINE": "cloudflare_d1",
    "D1_DATABASE_NAME": "rbtexam-db",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "1020517148526-5a5f4jrr63v0u99vfalamqdrb7blm0ob.apps.googleusercontent.com",
    "NEXT_PUBLIC_SITE_URL": "https://www.rbtpracticeai.com"
  }
}
